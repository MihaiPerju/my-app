[alembic]
script_location = src/db/migrations
prepend_sys_path = src
path_separator = os
version_path_separator = os
{{#if (has "code-quality")}}

# A generated revision has to pass the app's own lint and format gates as written: `ruff check
# --fix` sorts the template's imports and drops the ones the revision leaves unused (`sqlmodel` in a
# merge or data-only revision), then `ruff format` lays it out. Fix runs first, since removing an
# import can change the formatting. Only `code-quality` installs ruff (and owns those gates), so
# without it there are no hooks: Alembic would write the revision, then fail on the missing binary.
[post_write_hooks]
hooks = ruff_fix, ruff_format
ruff_fix.type = exec
ruff_fix.executable = ruff
ruff_fix.options = check --fix REVISION_SCRIPT_FILENAME
ruff_format.type = exec
ruff_format.executable = ruff
ruff_format.options = format REVISION_SCRIPT_FILENAME
{{/if}}

[loggers]
keys = root,sqlalchemy,alembic

[handlers]
keys = console

[formatters]
keys = generic

[logger_root]
level = WARNING
handlers = console
qualname =

[logger_sqlalchemy]
level = WARNING
handlers =
qualname = sqlalchemy.engine

[logger_alembic]
level = INFO
handlers =
qualname = alembic

[handler_console]
class = StreamHandler
args = (sys.stderr,)
level = NOTSET
formatter = generic

[formatter_generic]
format = %(levelname)-5.5s [%(name)s] %(message)s
datefmt = %H:%M:%S
