                return 401, { detail = "Identity unavailable" }
              end
              local payload = ngx.decode_base64(raw)
              if not payload then
                core.log.error("edge-auth: X-Userinfo is not valid base64")
                return 401, { detail = "Identity unavailable" }
              end
              local claims, err = core.json.decode(payload)
              if not claims or not claims.sub then
                core.log.error("edge-auth: no sub claim: ", err or "nil")
                return 401, { detail = "Identity unavailable" }
              end
              core.request.set_header(ctx, "X-User-Id", claims.sub)
              core.request.set_header(ctx, "X-User-Email", claims.email)
              core.request.set_header(ctx, "X-Userinfo", nil)
              core.request.set_header(ctx, "X-ID-Token", nil)
              core.request.set_header(ctx, "X-Refresh-Token", nil)
              -- openid-connect has already consumed the bearer token by this phase, and
              -- the app never reads it. Dropping it keeps raw credentials out of the
              -- upstream's request logs and error reports.
              core.request.set_header(ctx, "Authorization", nil)
            end
{{/if}}

{{/if}}{{#if (has "tanstack-start")}}{{#unless (has "fastapi")}}routes:
{{/unless}}  - uri: /*
    priority: 1
    # Pass WebSocket upgrades through, so the Vite dev server's HMR socket (same origin, carried by
    # the session cookie) reaches web. Without it the upgrade is proxied as a plain GET and answered
    # with the app's redirect, and every edit needs a manual reload.
    enable_websocket: true
    upstream:
      nodes:
        "web:3001": 1
      type: roundrobin
    plugins:
      # The web app renders from its session cookie and never reads an identity header,
      # so this route authenticates and strips but does not inject. A browser navigating
      # to a page is sent to the IdP rather than handed a 401.
      openid-connect:
        client_id: app
        client_secret: $\{{GATEWAY_OIDC_CLIENT_SECRET}}
        discovery: http://keycloak:8080/realms/{{projectName}}/.well-known/openid-configuration
        realm: {{projectName}}
        scope: openid profile email
        # Same reason as /api/*: without a bearer validator the plugin only ever takes
        # the session branch, so a token-carrying client (the smoke test, any scripted
        # fetch of the shell) gets bounced to the login page instead of served.
        introspection_endpoint: http://keycloak:8080/realms/{{projectName}}/protocol/openid-connect/token/introspect
        set_userinfo_header: false
        set_access_token_header: false
        access_token_in_authorization_header: false
        set_id_token_header: false
        session:
          secret: $\{{GATEWAY_SESSION_SECRET}}
      proxy-rewrite:
        headers:
          remove: ["x-user-id", "x-user-email"]
          set:
            X-Forwarded-Host: "$host"
            X-Forwarded-Proto: "$scheme"
            X-Forwarded-For: "$remote_addr"

{{/if}}#END
