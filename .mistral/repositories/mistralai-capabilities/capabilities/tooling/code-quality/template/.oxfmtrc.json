{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "packages/ts/atelier/**",
    "packages/ts/common/**",
    "packages/ts/i18n/**",
    "packages/ts/markdown/**",
    "packages/ts/next-hotkey/**",
    "packages/ts/tailwind-config/**",
    "packages/ts/tsconfig/**",
    ".sisyphus/**",
    ".agents/skills/workflows/**",
    "**/*.gen.ts",
    "**/api/generated/**",
