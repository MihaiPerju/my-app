# =============================================================================
# apps/web/.env — TanStack Start web app (Vite SSR, :3001)
#
# Only VITE_-prefixed vars are exposed to the client bundle.
# Copy to `.env`. `.env` is gitignored.
# =============================================================================

# --- API base URL ------------------------------------------------------------
# Validated by src/env.ts. Generated API paths already include /api, so the default base is
# same-origin. For local `bunx nx run compose:dev` (web :3001 + api :3000), set this to the API
# origin: the API already CORS-allows http://localhost:3001. Use 127.0.0.1 (not localhost) so the
# browser reaches the API over IPv4 — localhost resolves to ::1 first, where the API does not
# listen. Leave empty only when the web app is served same-origin with the API (e.g. behind the
# :9080 gateway).
VITE_API_URL=http://127.0.0.1:3000

# --- Tooling -----------------------------------------------------------------
# Set to 1 to skip env schema validation (used by container builds).
# SKIP_ENV_VALIDATION=
