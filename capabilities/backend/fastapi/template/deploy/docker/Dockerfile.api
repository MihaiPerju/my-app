# syntax=docker/dockerfile:1.7-labs
# API image for apps/api. Self-contained: the build and runtime stages are the canonical Python
# workspace image, kept byte-identical with the worker and init Dockerfiles (tests/registry pins the
# shared toolchain and build pipeline across all three). `api` is the production runtime; `api-dev`
# is the hot-reload dev target.
FROM python:3.14-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.11.17 /uv /uvx /bin/
RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV UV_PYTHON_PREFERENCE=only-system \
    UV_NO_PYTHON_DOWNLOADS=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1
ARG REGISTRY_PY_USER
COPY tools/uv.sh /tmp/registry-uv.sh
COPY tools/docker/sync-python-workspace.sh /usr/local/bin/sync-python-workspace
# Preserve source paths for workspace manifests and vendored Git capability packages. The latter is a
# wildcard because package-source apps do not contain `.mistral/repositories`.
COPY --parents pyproject.toml uv.lock packages/py/*/pyproject.toml apps/*/pyproject.toml .mistral/repositories/*/capabilities/*/*/package/py ./
RUN --mount=type=secret,id=registry_token \
    --mount=type=cache,target=/root/.cache/uv \
    if [ -f /run/secrets/registry_token ]; then \
        registry_user="${REGISTRY_PY_USER:-$(sed -n 's/^export MISTRAL_REGISTRY_USER=//p' /tmp/registry-uv.sh)}" && \
        test -n "$registry_user" && \
        registry_password="$(cat /run/secrets/registry_token)" && \
        export UV_INDEX_MISTRALAI_USERNAME="$registry_user" \
               UV_INDEX_MISTRALAI_PASSWORD="$registry_password"; \
    fi && \
    sync-python-workspace dependencies
COPY . .
RUN --mount=type=secret,id=registry_token \
    --mount=type=cache,target=/root/.cache/uv \
    if [ -f /run/secrets/registry_token ]; then \
        registry_user="${REGISTRY_PY_USER:-$(sed -n 's/^export MISTRAL_REGISTRY_USER=//p' /tmp/registry-uv.sh)}" && \
        test -n "$registry_user" && \
        registry_password="$(cat /run/secrets/registry_token)" && \
        export UV_INDEX_MISTRALAI_USERNAME="$registry_user" \
               UV_INDEX_MISTRALAI_PASSWORD="$registry_password"; \
    fi && \
    sync-python-workspace runtime

FROM python:3.14-slim AS runtime
COPY --from=ghcr.io/astral-sh/uv:0.11.17 /uv /uvx /bin/
WORKDIR /app
ENV UV_PYTHON_PREFERENCE=only-system \
    UV_NO_PYTHON_DOWNLOADS=1 \
    UV_CACHE_DIR=/tmp/uv-cache \
    XDG_CACHE_HOME=/tmp \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:${PATH}"
RUN groupadd -g 1000 app && \
    useradd -u 1000 -g 1000 -m -s /usr/sbin/nologin app
COPY --from=build --chown=1000:1000 /app /app
USER 1000:1000

FROM runtime AS api
ENV HOST=0.0.0.0 PORT=3000
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=15s \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:${PORT:-3000}/api/health/live', timeout=5).status==200 else 1)"
CMD ["sh", "-c", "exec uv run --frozen --no-dev --no-sync --directory apps/api uvicorn api.main:app --host \"$HOST\" --port \"$PORT\" --proxy-headers --timeout-graceful-shutdown 20"]

FROM build AS development
ARG REGISTRY_PY_USER
RUN --mount=type=secret,id=registry_token \
    --mount=type=cache,target=/root/.cache/uv \
    if [ -f /run/secrets/registry_token ]; then \
        registry_user="${REGISTRY_PY_USER:-$(sed -n 's/^export MISTRAL_REGISTRY_USER=//p' /tmp/registry-uv.sh)}" && \
        test -n "$registry_user" && \
        registry_password="$(cat /run/secrets/registry_token)" && \
        export UV_INDEX_MISTRALAI_USERNAME="$registry_user" \
               UV_INDEX_MISTRALAI_PASSWORD="$registry_password"; \
    fi && \
    sync-python-workspace dev
ENV UV_CACHE_DIR=/tmp/uv-cache \
    XDG_CACHE_HOME=/tmp \
    HOME=/tmp \
    UV_NO_SYNC=1 \
    WATCHFILES_FORCE_POLLING=true \
    PATH="/app/.venv/bin:${PATH}"

FROM development AS api-dev
ENV HOST=0.0.0.0 PORT=3000
EXPOSE 3000
CMD ["sh", "-c", "exec uv run --no-sync --directory apps/api python -m api.dev"]
