{
  "id": "search",
  "version": "0.0.0",
  "title": "Search",
  "description": "Hybrid search: ingestion and reconcile against object storage, ANN + BM25 Postgres and local stores, and retrieval-quality evaluation.",
  "kind": "feature",
  "categories": [
    "solutions"
  ],
  "dependencies": [
    "core",
    "postgres",
    "bucket",
    "agents",
    "workflows"
  ],
  "packages": [
    "ts",
    "py"
  ],
  "envVars": {
