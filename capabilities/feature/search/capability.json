    "VESPA_APP_NAME": "{{app_name}}",
    "SEARCH_MAX_ATOMS_PER_SOURCE": "2000",
    "SEARCH_AGENT_MAX_ITERATIONS": "10",
    "SEARCH_AGENT_TOOL_BUDGET": "20",
    "SEARCH_AGENT_CONTEXT_BUDGET": "40",
    "SEARCH_AGENT_PER_SOURCE_BUDGET": "8",
    "SEARCH_AGENT_COMPACT_THRESHOLD": "120000",
    "INGESTION_ENABLED": "false",
    "INGESTION_SCHEDULE_ID": "{{app_name}}-ingestion",
