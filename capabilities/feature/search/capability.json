    "INGESTION_CRON": "",
    "INGESTION_SOURCE_PREFIX": "",
    "INGESTION_FILESYSTEM_ROOT": "",
    "INGESTION_S3_REGION": "",
    "INGESTION_S3_SESSION_TOKEN": "",
    "INGESTION_GCS_BUCKET": "",
    "INGESTION_GCS_SERVICE_ACCOUNT_FILE": "",
    "INGESTION_GCS_API_ROOT": "",
    "INGESTION_AZURE_CONTAINER": "",
